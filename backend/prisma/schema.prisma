generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IpLookup {
  id          Int      @id @default(autoincrement())
  ip          String

  country     String?
  countryName String?
  region      String?
  city        String?
  timezone    String?

  latitude    Float?
  longitude   Float?

  createdAt   DateTime @default(now())

  @@index([ip])
  @@index([createdAt])
}